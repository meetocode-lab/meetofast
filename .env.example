# ==============================================================================
# Meofast Self-Hosted Environment Configuration (Optional)
# ==============================================================================
# NOTE: You do NOT need to configure database credentials here!
# Simply run `docker compose up -d` and open http://YOUR_SERVER_IP:4780 to
# configure PostgreSQL, MySQL, MariaDB, or SQLite via the Web Setup Wizard.
# ==============================================================================

# Public HTTP port exposed on host
MEOFAST_PORT=4780

# Node runtime mode
NODE_ENV=production

# Internal Hono API port & URL (used by Next.js server-side proxy)
API_PORT=4781
INTERNAL_API_URL=http://api:4781

# Persistent data directory inside API container (stores master.key, config.enc.json, install.lock, sqlite)
MEOFAST_DATA_DIR=/app/data

# Optional: Bring your own 64-char hex master key for AES-256-GCM encryption.
# If left empty, Meofast automatically generates and persists `/app/data/master.key` (chmod 0600).
MEOFAST_MASTER_KEY=

# ==============================================================================
# Optional Bundled PostgreSQL Settings (used only by docker-compose.production.yml)
# ==============================================================================
POSTGRES_DB=meofast
POSTGRES_USER=meofast
POSTGRES_PASSWORD=change_this_strong_postgres_password
